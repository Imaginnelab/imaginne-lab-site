# Local checkout only. Do not commit real keys; use a separate Stripe sandbox.
STRIPE_CHECKOUT_ENABLED=true
CHECKOUT_SITE_URL=http://localhost:3000
# Prefer a restricted sandbox key with Checkout Sessions write/read permissions.
STRIPE_SECRET_KEY=
# From stripe listen --forward-to localhost:3000/api/stripe/webhook/
STRIPE_WEBHOOK_SECRET=
# Simulated shipping within Canada, in CAD cents. No real shipment is created.
STRIPE_TEST_SHIPPING_CENTS=0
# Enable only after configuring sandbox Tax settings and an active CA registration.
# Also requires Tax Settings and Tax Registrations read permissions.
STRIPE_TAX_ENABLED=false
